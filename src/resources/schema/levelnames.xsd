<?xml version="1.0" encoding="UTF-8" ?>
<xs:schema elementFormDefault="qualified" xmlns:xs="http://www.w3.org/2001/XMLSchema">
    <xs:element name="levels">
        <xs:complexType>
            <xs:sequence>
                <xs:element minOccurs="1" maxOccurs="unbounded" name="category" type="category" />
            </xs:sequence>
        </xs:complexType>
    </xs:element>
    <xs:complexType name="category">
        <xs:sequence minOccurs="0" maxOccurs="unbounded">
            <xs:element minOccurs="0" maxOccurs="unbounded" name="category" type="category" />
            <xs:element minOccurs="0" maxOccurs="unbounded" name="level" type="level" />
        </xs:sequence>
        <xs:attribute name="name" type="xs:string" use="required" />
    </xs:complexType>
    <xs:complexType name="level">
        <xs:simpleContent>
            <xs:extension base="xs:string">
                <xs:attribute name="file" type="levelfile" use="required" />
                <xs:attribute name="name" type="xs:string" use="required" />
            </xs:extension>
        </xs:simpleContent>
    </xs:complexType>
    <xs:simpleType name="levelfile">
         <xs:restriction base="xs:string">
             <xs:pattern value="\d{2}-\d{2}" />
         </xs:restriction>
    </xs:simpleType>
</xs:schema>
