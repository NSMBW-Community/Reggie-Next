<?xml version="1.0" encoding="UTF-8" ?>
<xs:schema elementFormDefault="qualified" xmlns:xs="http://www.w3.org/2001/XMLSchema">
    <xs:element name="translation">
        <xs:complexType>
            <xs:sequence minOccurs="0" maxOccurs="unbounded">
                <xs:element minOccurs="1" maxOccurs="unbounded" name="section" type="SectionType" />
            </xs:sequence>
        </xs:complexType>
    </xs:element>
    <xs:complexType name="SectionType">
        <xs:choice minOccurs="0" maxOccurs="unbounded">
            <xs:element minOccurs="0" maxOccurs="unbounded" name="section" type="SectionType" />
            <xs:element minOccurs="0" maxOccurs="unbounded" name="string" type="string" />
        </xs:choice>
        <xs:attribute name="id" type="ID" use="required" />
    </xs:complexType>
    <xs:complexType name="string">
        <xs:simpleContent>
            <xs:extension base="xs:string">
                <xs:attribute name="id" type="ID" use="required" />
            </xs:extension>
        </xs:simpleContent>
    </xs:complexType>
    <xs:simpleType name="ID">
         <xs:restriction base="xs:string">
             <xs:pattern value="[a-z0-9_\-]+" />
         </xs:restriction>
    </xs:simpleType>
</xs:schema>
